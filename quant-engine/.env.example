# =============================================================================
# quant-engine configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
#
# Precedence: real environment variables > `.env` > `config/config.yaml` > code
# defaults. A value already present in the process environment is never
# overwritten by `.env`, so a container/supervisor-provided value always wins.
#
# Naming: nested settings use `QUANT__SECTION__FIELD` (double underscore between
# the prefix and each level, e.g. `QUANT__RISK__MAX_LEVERAGE`). The exchange
# credentials are additionally accepted as `QUANT_EXCHANGE__API_KEY` /
# `QUANT_EXCHANGE__API_SECRET` (single underscore) — both forms are read, and both
# are verified in scripts/test_*. The nested form is shown below.
#
# Nothing in here is a real credential. Do not paste real values into this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Exchange credentials — the only secrets this service needs.
#
# SECURITY REQUIREMENTS for a trade key:
#   - Enable ONLY "Futures / Read + Trade". NEVER enable withdrawals.
#   - Bind the key to this host's egress IP if the exchange supports it.
#   - Use a sub-account funded with only what you are willing to risk.
#   - Use a DIFFERENT key from any other system. Two services sharing one key
#     means one leak compromises both, and neither can be rotated independently.
#
# If these are empty the engine runs in PAPER mode against REAL market data:
# real prices, candles, funding and order books, with a real cost model. Only the
# fills are simulated. No order is ever sent to the exchange.
# -----------------------------------------------------------------------------
QUANT__EXCHANGE__API_KEY=
QUANT__EXCHANGE__API_SECRET=

# Accepted alias for the two keys above:
# QUANT_EXCHANGE__API_KEY=
# QUANT_EXCHANGE__API_SECRET=

# NOT read by this engine: BYBIT_API_KEY / BYBIT_API_SECRET.
#
# The Node service at the repository root uses those names. This engine reads only the
# `QUANT__EXCHANGE__API_KEY` / `QUANT_EXCHANGE__API_KEY` forms above. Setting BYBIT_API_KEY
# here fails silently — the engine simply starts in paper mode — which is a safe failure but
# a confusing one, so it is called out explicitly rather than left to be discovered.
#
# The two services must also use DIFFERENT exchange keys. Sharing one key means a single
# leak compromises both and neither can be rotated independently.

# Expected egress IP for this host. When set, the engine can warn that the key's
# IP allowlist no longer matches the address the exchange will actually see.
QUANT__EXCHANGE__EXPECTED_HOST_IP=

# -----------------------------------------------------------------------------
# Live-trading interlocks. Live order routing is refused unless ALL of these are
# satisfied at once. Each gate is independent, and each defaults to the SAFE
# value, so an omitted setting can only ever make the engine more conservative.
#
#   1. QUANT__EXECUTION__MODE=live        (default: paper)
#   2. QUANT__EXECUTION__ALLOW_LIVE=true  (default: false)
#   3. credentials present and valid
#   4. QUANT_LIVE_TRADING_ACK=yes         (default: unset -> refused)
#
# The fourth exists because the first three can all be set by a config change,
# whereas this one is a deliberate, human act of acknowledgement. Leave it unset.
# -----------------------------------------------------------------------------
QUANT__EXECUTION__MODE=paper
QUANT__EXECUTION__ALLOW_LIVE=false

# Master interlock. Live order routing is refused unless this is exactly "yes"
# AND credentials are present AND execution.mode is "live".
QUANT_LIVE_TRADING_ACK=

# -----------------------------------------------------------------------------
# Dashboard API
# -----------------------------------------------------------------------------
# Bearer token for the dashboard and API. Auto-generated and persisted on first
# boot when empty, so it stays stable across restarts instead of rotating.
QUANT__API__TOKEN=

# Bind address. Keep 127.0.0.1 unless a reverse proxy with TLS terminates in front.
QUANT__API__HOST=0.0.0.0
QUANT__API__PORT=8080

# Comma-separated browser origins allowed to call the API. Tighten before exposing
# the dashboard publicly; the default of * is fine only behind a private network.
QUANT__API__CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Market data
# -----------------------------------------------------------------------------
QUANT__DATA__PRIMARY_INTERVAL=1h
QUANT__DATA__HISTORY_BARS=10000
QUANT__DATA__KLINE_LIMIT=1000
QUANT__DATA__PERSIST_CANDLES=true
QUANT__DATA__WS_ENABLED=true
QUANT__DATA__WS_STALE_TIMEOUT_S=90
QUANT__DATA__REST_POLL_SECONDS=30
QUANT__DATA__DB_PATH=data/db/quant.db

# -----------------------------------------------------------------------------
# Risk — these are the money limits. Read them before changing them.
# -----------------------------------------------------------------------------
QUANT__RISK__STARTING_EQUITY=10000
QUANT__RISK__RISK_PER_TRADE_PCT=0.5
QUANT__RISK__MAX_LEVERAGE=5
QUANT__RISK__MAX_POSITION_NOTIONAL_PCT=25
QUANT__RISK__MAX_CONCURRENT_POSITIONS=3
QUANT__RISK__MAX_GROSS_EXPOSURE_X=1
QUANT__RISK__DAILY_LOSS_LIMIT_PCT=3
QUANT__RISK__MAX_DRAWDOWN_PCT=12
QUANT__RISK__MAX_SPREAD_BPS=4
QUANT__RISK__MAX_DATA_AGE_S=180
# Creating this file halts new entries immediately (kill switch).
QUANT__RISK__HALT_FILE=data/HALT

# -----------------------------------------------------------------------------
# Costs — every number is subtracted from gross edge before a trade is allowed.
# -----------------------------------------------------------------------------
QUANT__COSTS__MAKER_FEE_BPS=2.0
QUANT__COSTS__TAKER_FEE_BPS=5.5
QUANT__COSTS__FALLBACK_SLIPPAGE_BPS=2.0
QUANT__COSTS__ADVERSE_SELECTION_BPS=1.0
QUANT__COSTS__HURDLE_MULTIPLIER=2.0
QUANT__COSTS__MIN_EDGE_BPS=8.0

# -----------------------------------------------------------------------------
# Strategy and walk-forward learning
# -----------------------------------------------------------------------------
QUANT__STRATEGY__MIN_EDGE_SAMPLES=10
QUANT__STRATEGY__MIN_EDGE_TSTAT=1.0
QUANT__LEARNING__ENABLED=true
QUANT__LEARNING__OPTIMIZE_EVERY_HOURS=24
QUANT__LEARNING__LOOKBACK_BARS=4000
QUANT__LEARNING__TRAIN_BARS=1200
QUANT__LEARNING__TEST_BARS=400
QUANT__LEARNING__STEP_BARS=300

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# Path to this file if it is not ./env at the project root.
# QUANT_ENV_FILE=
QUANT__LOG_LEVEL=INFO
QUANT__LOG_JSON=true
