# secrets — never commit
.env
data/dashboard_token*
*.token
*credential*
*.pem
*.key

# build artifacts (regenerated by ops/build.sh)
build/

# runtime state
data/db/
data/logs/
data/backups/

# Audit notes belonging to a DIFFERENT repository (gigpilot-platform). They live in this
# workspace for the operator's convenience but are not part of this platform, and must not
# be swept into a release commit by `git add -A`.
gigpilot-*.md
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
