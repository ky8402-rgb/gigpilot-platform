# Templated systemd unit. ops/production/install.sh substitutes:
#   __APP_DIR__ __APP_USER__ __ENV_DIR__ __PORT__
#
# Hardening notes:
#   * unprivileged user, no login shell
#   * ProtectSystem=strict confines writes to the app's data dir and its logs
#   * credentials come from an EnvironmentFile with 0600 permissions
#   * Restart=always so the supervisor restarts a crashed engine (state is
#     persisted in SQLite, and risk guards are restored from it on boot)
[Unit]
Description=Futures Quant Trading Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__

WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_DIR__/quant.env
Environment=PYTHONUNBUFFERED=1
Environment=QUANT_API__PORT=__PORT__

ExecStart=__APP_DIR__/.venv/bin/python -m app.main --host 127.0.0.1 --port __PORT__
Restart=always
RestartSec=5
StartLimitIntervalSec=0

StandardOutput=append:/var/log/quant/stdout.log
StandardError=append:/var/log/quant/stderr.log

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_DIR__/data /var/log/quant
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
