# Single-owner private autonomous crypto trading platform
# Copy to a local, untracked environment file and fill every value securely.
# Never commit real credentials, wallet addresses, session secrets, or production URLs.
OWNER_AUTH_PIN=
OWNER_SESSION_SECRET=

# Supported exchange adapter (Bybit)
EXCHANGE_DEFAULT=bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Wallet profit sweep subsystem
DESTINATION_WALLET_ADDRESS=
WALLET_CHAIN=
AUTO_SWEEP_ENABLED=false
AUTO_SWEEP_MIN_THRESHOLD_USD=50
PROFIT_RESERVE_BUFFER_USD=100

# Trading and risk engine defaults
INITIAL_TRADING_CAPITAL_USD=0
MAX_POSITION_SIZE_PCT=20
MAX_DAILY_LOSS_PCT=5
MAX_DRAWDOWN_LIMIT_PCT=15
MAX_OPEN_ORDERS=50
MAX_SLIPPAGE_BPS=30
GLOBAL_KILL_SWITCH_ACTIVE=true
DEFAULT_AUTONOMY_LEVEL=0
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=

# Google Gemini API key (server-side only)
GEMINI_API_KEY=

# Base server and database configuration
DATABASE_URL=
PORT=3000
BASE_URL=
VITE_BACKEND_URL=

# GitHub webhook secret
GITHUB_WEBHOOK_SECRET=
