[flake8]
# Only lint repository-owned Python; .venv and installed third-party packages are not project source.
exclude = .venv,.git,node_modules,dist,build,.mypy_cache,.ruff_cache,.pytest_cache

# The project standard is 120 columns. flake8's built-in default of 79 is a legacy default this
# codebase has never followed, and at 79 it reported 4,566 E501 findings for lines compliant with the
# standard — pure noise burying the findings that mattered.
max-line-length = 120

# The compact single-line style below is used pervasively and is ACCEPTED BY RUFF, which runs in CI.
# flake8 disagreeing with ruff about the same source is not a standard, it is two standards; these
# entries align flake8 to the one the project actually enforces. No check is disabled wholesale.
extend-ignore =
    # `if not self.armed: return` / `try: ... except X: pass` on one line. Deliberate and consistent.
    E701,
    # `a = 1; b = 2` grouping of tightly related assignments.
    E702,
    # gigpilot.py bootstraps sys.path BEFORE importing the package, so imports legitimately follow
    # executable statements at module level. This is the standard shape for a runnable entry module.
    E402,
